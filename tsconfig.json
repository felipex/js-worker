{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext"],
		"types": ["./worker-configuration.d.ts"],
		"noEmit": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"worker-configuration.d.ts",
		"node_modules/@cloudflare/vitest-plugin/types/cloudflare-test.d.ts"
	]
}